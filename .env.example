# Copy this file to .env only when environment-based LLM defaults are needed.
OPENAI_API_KEY=
NSPA_LLM_MODEL=gpt-4o-mini
NSPA_LLM_BASE_URL=https://api.openai.com/v1
NSPA_LLM_CHAT_PATH=/chat/completions

# Local task limits.
NSPA_WEB_WORKERS=2
NSPA_MAX_UPLOAD_BYTES=1073741824

# Docker build package mirror. Leave empty to use Ubuntu official sources.
ONECVE_APT_MIRROR=http://mirrors.aliyun.com/ubuntu
